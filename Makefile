DB_USER = admin
DB_NAME = showcase
DB_URL = postgres://admin:password@localhost:5432/showcase?sslmode=disable
GOOSE_MIGRATION_DIR=internal/infra/storage/db/migrate/sql

SQL_PATHS = internal/infra/storage/db/migrate/sql

.PHONY: test
test:
	go test ./... -race -coverprofile=coverage.out -covermode=atomic

.PHONY: lint
lint:
	golangci-lint run

.PHONY: lint-fix
lint-fix:
	golangci-lint run --fix

.PHONY: sql-lint
sql-lint:
	sqlfluff lint --disable-progress-bar $(SQL_PATHS)

.PHONY: sql-fix
sql-fix:
	sqlfluff fix --disable-progress-bar $(SQL_PATHS)

# The packages holding go:generate lines, in the order their output is used: a generator loads the packages its own
# imports, which have to hold their generated code by then. ./... after them runs any package the list leaves out.
GEN_PACKAGES = \
	./internal/messages \
	./internal/feature/todo/model \
	./config \
	./internal/di \
	./internal/feature/todo/scopes \
	./internal/feature/todo/repository \
	./internal/feature/todo/usecase \
	./internal/feature/todo/mapper \
	./internal/feature/todo/handler

# protobuf first, as kanna-mapper reads the types buf writes. One step after the other, which prerequisites would not
# keep under make -j.
.PHONY: gen
gen:
	$(MAKE) gen-proto
	$(MAKE) gen-go

.PHONY: gen-go
gen-go:
	go generate $(GEN_PACKAGES) ./...

# Both the protobuf code and the kanna output, each checked against what is committed.
.PHONY: gen-check
gen-check:
	$(MAKE) gen-proto-check
	KANNA_CHECK=1 go generate $(GEN_PACKAGES) ./...

# Delete what the kanna generators wrote and generate it again in one run, as after a clone that lost it, to check that
# GEN_PACKAGES is in an order that needs no second run. On success the tree is as it was.
.PHONY: gen-fresh-check
gen-fresh-check:
	git ls-files -z '*.go' | xargs -0 grep -lZ '^// Code generated by kanna-' | xargs -0 rm -f
	$(MAKE) gen-go
	go vet ./...
	git diff --exit-code

.PHONY: gen-proto
gen-proto:
	cd proto && buf generate

# buf has no mode that only checks, so regenerate and fail on any difference from what is committed, a file added or
# left over included. A message nothing in Go uses yet compiles either way, so only this tells it was not generated.
.PHONY: gen-proto-check
gen-proto-check: gen-proto
	git diff --exit-code -- internal/gen
	test -z "$$(git status --porcelain -- internal/gen)"

.PHONY: db-create
db-create:
	docker compose exec -T db psql -U $(DB_USER) -d postgres -tAc \
		"SELECT 1 FROM pg_database WHERE datname = '$(DB_NAME)'" | grep -q 1 || \
		docker compose exec -T db createdb -U $(DB_USER) $(DB_NAME)

.PHONY: db-migrate
db-migrate:
	GOOSE_MIGRATION_DIR=$(GOOSE_MIGRATION_DIR) go tool goose postgres $(DB_URL) up

.PHONY: db-describe
db-describe:
	go tool kanna-orm describe -database-url $(DB_URL) ./...

.PHONY: db-describe-check
db-describe-check:
	go tool kanna-orm describe -check -database-url $(DB_URL) ./...

.PHONY: db-drop
db-drop:
	docker compose exec -T db dropdb -U $(DB_USER) --force --if-exists $(DB_NAME)

.PHONY: db-reset
db-reset: db-drop db-create db-migrate

.POHNY: new-migration
new-migration:
	@if [ -z "$(name)" ]; then \
		echo "Error: name is required. Usage: make new-migration name=migration_name"; \
		exit 1; \
	fi
	go tool goose -dir internal/infra/storage/db/migrate/sql create $(name) sql
